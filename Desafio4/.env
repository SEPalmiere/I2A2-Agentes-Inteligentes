# =============================================================================
# CONFIGURAÇÕES DO SISTEMA VR/VA - TEMPLATE EXEMPLO
# =============================================================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha com suas credenciais reais
# 3. NUNCA commite o arquivo .env no GitHub
# 

# 🔐 CONFIGURAÇÕES DE EMAIL (OBRIGATÓRIO)
# Para Gmail: Use senha de app, não sua senha normal
# Como configurar: https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui

# 📧 DESTINATÁRIOS DOS EMAILS (OBRIGATÓRIO)
# Email da empresa fornecedora de VR/VA
EMAIL_VR=fornecedor@empresavr.com
# Email do RH interno da sua empresa
EMAIL_RH=rh@suaempresa.com

# 🤖 CONFIGURAÇÕES DO OLLAMA (OPCIONAL)
# URL onde o Ollama está rodando
OLLAMA_BASE_URL=http://localhost:11434
# Modelo a ser usado (baixe com: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# 🎛️ CONFIGURAÇÕES DO CREWAI (OPCIONAL)
CREWAI_VERBOSE=false
CREWAI_LOG_LEVEL=ERROR

# 🔧 CONFIGURAÇÕES GERAIS DO SISTEMA
DEBUG=True
VR_COMPETENCIA_PADRAO=05/2025
VR_PERCENTUAL_EMPRESA=0.80
VR_PERCENTUAL_FUNCIONARIO=0.20
VR_DIA_CORTE_DESLIGAMENTO=15

# 🛡️ CONFIGURAÇÕES DE SEGURANÇA (OPCIONAL)
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=xlsx,xls

# =============================================================================
# EXEMPLO DE CONFIGURAÇÃO PARA DIFERENTES PROVEDORES DE EMAIL
# =============================================================================

# 📧 GMAIL (RECOMENDADO)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=seuemail@gmail.com
# EMAIL_PASSWORD=sua_senha_de_app

# 📧 OUTLOOK/HOTMAIL
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587
# EMAIL_USER=seuemail@outlook.com
# EMAIL_PASSWORD=sua_senha

# 📧 YAHOO
# SMTP_SERVER=smtp.mail.yahoo.com
# SMTP_PORT=587
# EMAIL_USER=seuemail@yahoo.com
# EMAIL_PASSWORD=sua_senha

# =============================================================================
# NOTAS IMPORTANTES DE SEGURANÇA
# =============================================================================
#
# 🚨 NUNCA COMMITE CREDENCIAIS REAIS NO GITHUB!
# 
# ✅ Para Gmail:
#   1. Ative verificação em 2 etapas
#   2. Gere uma "senha de app" específica
#   3. Use a senha de app, não sua senha normal
#
# ✅ Para outros provedores:
#   1. Verifique se permitem aplicações de terceiros
#   2. Configure autenticação específica se necessário
#
# ✅ Teste sua configuração:
#   1. Execute: python teste_email_diagnostico.py
#   2. Verifique se recebe o email de teste
#
